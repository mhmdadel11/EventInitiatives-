@model EventInitiatives.Mvc.Controllers.LoginViewModel
@{
    Layout = null;
    var returnUrl = ViewData["ReturnUrl"] as string;
}
<!doctype html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تسجيل الدخول - إدارة المنشورات والمبادرات</title>
    <link rel="stylesheet" href="~/css/style.css" />
</head>
<body>
    <section class="auth-screen">
        <form asp-controller="Account" asp-action="Login" method="post" class="auth-card">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="auth-mark">✦</div>
            <h1>نظام إدارة المنشورات والمبادرات</h1>
            <p>سجّل الدخول باستخدام حساب الموظف</p>
            <div asp-validation-summary="ModelOnly" class="auth-error" role="alert"></div>
            <label for="Email">البريد الإلكتروني
                <input asp-for="Email" type="email" autocomplete="username" required placeholder="name@company.com" />
                <span asp-validation-for="Email" class="auth-error"></span>
            </label>
            <label for="Password">كلمة المرور
                <input asp-for="Password" type="password" autocomplete="current-password" required placeholder="••••••••" />
                <span asp-validation-for="Password" class="auth-error"></span>
            </label>
            <label class="remember-login">
                <input asp-for="RememberMe" type="checkbox" /> تذكرني على هذا الجهاز
            </label>
            <button type="submit" class="primary">تسجيل الدخول</button>
            <p class="auth-register-link">أول مرة تستخدم النظام؟ <a asp-controller="Account" asp-action="Register">إنشاء حساب جديد</a></p>
        </form>
    </section>
</body>
</html>
